# ==========================================
# PenRX+ Official Git Ignore Configuration
# ==========================================

# 1. Dependencies & Package Stores
node_modules/
.pnpm-store/
.yarn/
vendor/

# 2. Next.js & Web Application Outputs
.next/
out/
build/
dist/
dist-ssr/

# 3. Desktop Electron & Native Build Artifacts
dist-electron/
release-packages/
releases/
*.exe
*.msi
*.dmg
*.app
*.zip
*.tar.gz

# 4. Mobile & Android Native Builds (Capacitor)
android/.gradle/
android/app/build/
android/build/
android/captures/
android/.idea/
*.apk
*.aab
*.keystore
!android/app/penrx-release.keystore
*.jks

# 5. Environment Variables, Secret Keys & Text Files
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example
*.txt

# 6. Local Scratch & Temporary Test Scripts
scratch/
tmp/
temp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. Database Files & Caches
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# 8. TypeScript & Transpiler Caches
*.tsbuildinfo
next-env.d.ts

# 9. IDEs & Operating System Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
.gemini/
.agents/

# 10. Cloud Deployment Platforms & Cache
.vercel/
.turbo/
.cache/

# 11. Public Download Binaries (Generated locally)
public/downloads/*.apk
public/downloads/*.exe
public/downloads/*.zip
!public/downloads/.gitkeep

# 12. Security & Certificates
*.pem
*.cert
*.crt
*.key
