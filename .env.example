# ============================================================================
# PenRX+ — Official Production & Vercel Environment Variables
# ============================================================================
# هذا الملف هو القالب المرجعي الرسمي لجميع المتغيرات المطلوبة لتشغيل المشروع
# محلياً على جهازك أو سحابياً عند النشر على Vercel.
#
# 📌 طريقة الاستخدام:
# 1. للتشغيل المحلي: أنشئ ملفاً باسم `.env` واملأ القيم الحقيقية داخله.
# 2. للنشر على Vercel: انسخ هذه المتغيرات وضعها في:
#    Vercel Dashboard → Your Project → Settings → Environment Variables
# ============================================================================

# ----------------------------------------------------------------------------
# 1) إعدادات سوبا بيز (Supabase Configuration) — إلزامي
# ----------------------------------------------------------------------------
# رابط مشروع سوبا بيز الجديد (بدون شرطة مائلة / في النهاية)
NEXT_PUBLIC_SUPABASE_URL=https://zehmazkjbzhswigwkxgr.supabase.co

# مفتاح السيرفر السري (service_role secret) الخاص بمشروعك في Supabase
# يُجلب من: Supabase Dashboard → Project Settings → API → service_role (secret)
# ⚠️ تحذير: هذا المفتاح يعمل فقط من السيرفر، لا تشاركه مع أحد ولا تستخدم مفتاح anon مكانه.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-secret-key>


# ----------------------------------------------------------------------------
# 2) النطاقات والروابط السحابية (App URLs & CORS) — إلزامي
# ----------------------------------------------------------------------------
# الرابط الأساسي للنظام على Vercel
NEXT_PUBLIC_APP_URL=https://pen-rx.vercel.app

# الرابط السحابي الذي يتصل به تطبيق الديسكتوب (EXE) وتطبيق الأندرويد (APK) لمزامنة البيانات
PENRX_CLOUD_API_URL=https://pen-rx.vercel.app

# النطاقات المسموح لها بالاتصال بالسيرفر (CORS Allowed Origins)
PENRX_ALLOWED_ORIGINS=https://pen-rx.vercel.app


# ----------------------------------------------------------------------------
# 3) مفاتيح التشفير والحماية المركزية (Security Keys) — إلزامي
# ----------------------------------------------------------------------------
# مفتاح تشفير HMAC للتراخيص ورموز الأجهزة (سلسلة عشوائية من 64 حرف Hex)
# يمكنك توليده بأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PENRX_SECRET_KEY=<generate-64-hex-characters>

# مفتاح تشفير جلسات تسجيل الدخول لبورتال الإدارة (Admin Cookie Secret)
# يمكنك توليده بأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PENRX_ADMIN_SECRET=<generate-64-hex-characters>


# ----------------------------------------------------------------------------
# 4) بوابة تحكم الإدارة وتفعيل التراخيص (Master Admin Portal)
# ----------------------------------------------------------------------------
# تسجيل الدخول للبورتال يتم مباشرة باستخدام مصادقة Supabase Auth (البريد وكلمة المرور).
# فقط أنشئ مستخدم جديد في Supabase Dashboard → Authentication → Users
#
# (اختياري) حدد البريد الإلكتروني للمسؤول الحصري المسموح له بالدخول كمدير:
PENRX_ADMIN_EMAIL=admin@your-domain.com


# ----------------------------------------------------------------------------
# 5) خدمات الذكاء الاصطناعي (AI & Extra Features) — اختياري
# ----------------------------------------------------------------------------
# مفتاح Google Gemini API للتحليل الدوائي الذكي واكتشاف التداخلات الدوائية
# يُجلب من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-google-gemini-api-key>

# تعطيل إرسال تقارير Next.js عن بعد لتسريع البناء
NEXT_TELEMETRY_DISABLED=1
