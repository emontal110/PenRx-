# ============================================================================
# PenRX+ — REQUIRED ENVIRONMENT VARIABLES  (القائمة الرسمية للمتغيرات)
# ----------------------------------------------------------------------------
# هذا الملف هو المرجع الوحيد لكل متغيرات البيئة التي يقرأها المشروع.
# انسخه إلى `.env` للتشغيل المحلي، واضبط نفس الأسماء في:
#   Vercel → Project → Settings → Environment Variables  (Production + Preview)
#   GitHub → Settings → Secrets and variables → Actions  (للـ CI فقط)
#
# ⚠️ قواعد إلزامية:
#   1) لا تُضمّن `.env` إلى Git أبداً (موجود في .gitignore).
#   2) لا تكتب أي قيمة حقيقية في هذا الملف — placeholders فقط.
#   3) الأسرار تكون server-side فقط. المتغير الذي يبدأ بـ NEXT_PUBLIC_* يُضمَّن
#      في الكود المُسلَّم للمتصفح، فلا تضع فيه سراً أبداً.
#   4) تغيير أي قيمة هنا يستلزم Redeploy من Vercel لتصبح سارية.
#   5) كل الأسرار تُقرأ من البيئة فقط (src/lib/env.ts). أي نقص يرفض الطلب عند
#      التشغيل (fail-closed). نسخة سطح المكتب المُغلَّفة تُوزَّع بدون هذه القيم
#      وتُمرّر الطلبات إلى السحابة (src/lib/cloudProxy.ts).
# ============================================================================

# ----------------------------------------------------------------------------
# 0) قائمة الأسماء للنسخ السريع إلى Vercel  (14 متغيراً)
# ----------------------------------------------------------------------------
#   إلزامي (7):
#     PENRX_SECRET_KEY
#     PENRX_ADMIN_SECRET
#     SUPABASE_SERVICE_ROLE_KEY
#     NEXT_PUBLIC_SUPABASE_URL
#     PENRX_ADMIN_EMAIL
#     PENRX_ADMIN_PASSWORD_HASH
#     PENRX_ADMIN_PIN_HASH
#   مُوصى به (4):
#     PENRX_ADMIN_SALT          بدونها يُستخدم salt ثابت في الكود العام
#     NEXT_PUBLIC_APP_URL       يُضاف تلقائياً لقائمة النطاقات المسموحة
#     PENRX_ALLOWED_ORIGINS     نطاقاتك الخاصة بخلاف نطاق Vercel
#     PENRX_CLOUD_API_URL       ضروري لنسخة سطح المكتب / APK
#   اختياري (3):
#     GEMINI_API_KEY                    مزايا الذكاء الاصطناعي
#     DATABASE_URL                      مسار Prisma فقط؛ مسار REST لا يحتاجه
#     ENABLE_RELATIONAL_DUAL_WRITE      "true" لكتابة الجداول العلائقية
# المتغيرات الباقية في هذا الملف أما محلية بحتة (SUPABASE_REST_URL للاختبارات)
# أو يضبطها التشغيل بنفسه — لا تنسخها إلى Vercel.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 1) أسرار التشفير — جهة السيرفر فقط  (إلزامي، ≥ 32 حرفاً عشوائياً)
# ----------------------------------------------------------------------------
# مفتاح HMAC لرموز الأجهزة والتراخيص.  يقرأه src/lib/env.ts:getSigningSecret()
# توليد قيمة:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PENRX_SECRET_KEY=<paste-64-hex-chars>

# مفتاح HMAC لجلسات بوابة الإدارة (cookie).  getAdminSecret()
# تغييره يُخرج كل الجلسات المفتوحة — وهذا مقصود عند التدوير.
PENRX_ADMIN_SECRET=<paste-64-hex-chars>

# ----------------------------------------------------------------------------
# 2) SUPABASE
# ----------------------------------------------------------------------------
# رابط المشروع العام — يجب أن يطابق https://<ref>.supabase.co تماماً (بدون / في النهاية).
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# المفتاح الخاص بخدمة السيرفر — يتجاوز RLS بالكامل.  أخطر قيمة في المنتج.
#   ✅ الصيغة الحديثة (الموصى بها): مفتاح يبدأ بـ sb_secret_ — من
#      Project Settings → API Keys → Create new API key → النوع Secret.
#      هذا ليس JWT، فلا يتأثر بتدوير مفتاح التوقيع أبداً ويبقى سارياً حتى تلغيه أنت.
#   ⚠️ الصيغة الإرثية: مفتاح يبدأ بـ eyJ... وهو JWT موقَّع بمفتاح التوقيع.
#      الذي يبدأ بـ eyJhbGciOiJIUzI1Ni هو HS256 المسرّب، وهو الآن في .env القديم
#      وفي بعض مخرجات البناء — سيتوقف فوراً لحظة إلغاء مفتاح التوقيع HS256.
#      ملاحظة مهمة: تدوير مفتاح التوقيع لا يُغيّر قيمة anon/service_role ولا يعيد
#      توقيعها؛ التدوير يغيّر توقيع توكنات المستخدمين الجدد فقط.  لذا الحصول على
#      قيمة جديدة يعني مفتاح sb_secret_ جديد، لا «نسخة ES256 من نفس المفتاح».
#   ❌ لا تستخدم sb_publishable_ (صلاحية anon فقط) ولا المعرِّف المكوّن من 64 حرفاً
#      hex الظاهر في شاشة JWT Keys (هذا ليس API key).
#   يجب ألا تظهر هذه القيمة في Installer أو في سجلات CI أو في ملف يُرفع للجيت.
SUPABASE_SERVICE_ROLE_KEY=<paste-sb-secret-key>

# ملاحظة: NEXT_PUBLIC_SUPABASE_ANON_KEY أُزيل من المشروع.
#   صفحة الاشتراك والبوابة لا تتصلان بـ Supabase مباشرة بعد الآن — كل الوصول
#   يمر عبر /api/* مع رمز جهاز مُوقَّع.  لا حاجة لتعريفه في Vercel أو في GitHub
#   Secrets، وأي نسخة قديمة منه تُعد مسرّبة وتُلغى من Supabase.

# اختياري: عنوان PostgREST صراحةً (الافتراضي = ${NEXT_PUBLIC_SUPABASE_URL}/rest/v1).
# لا تضبطه إلا للاختبارات على خادم محلي.
# SUPABASE_REST_URL=https://<your-project-ref>.supabase.co/rest/v1

# اختياري: اسم بديل يقبله env.ts عند غياب NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://<your-project-ref>.supabase.co

# اختياري: اتصال PostgreSQL مباشر لـ Prisma (src/lib/prisma.ts) ول فحص
# hasCloudCredentials.  مسار البيانات REST لا يحتاجه.
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ----------------------------------------------------------------------------
# 3) النطاقات والروابط
# ----------------------------------------------------------------------------
# الأصل العام الرسمي لهذا النشر (بدون / في النهاية).  يدخل في قائمة CORS وفي
# الروابط المطلقة، ويُضاف تلقائياً للنطاقات المسموحة.
NEXT_PUBLIC_APP_URL=https://pen-rx.vercel.app

# سيرفر السحابة الذي تمرر إليه نسخة سطح المكتب / APK الطلبات الخاصة.
# الاحتياطي: NEXT_PUBLIC_APP_URL ثم رابط الإنتاج المدمج.
# القيم المحلية (localhost / 127.0.0.1) مرفوضة في cloudProxy.ts.
PENRX_CLOUD_API_URL=https://pen-rx.vercel.app

# نطاقات حرفية مسموح لها باستدعاء /api بالجلسة، مفصولة بفواصل.  لا دعم للـ * .
# مسموح بالفعل دون ذكره: capacitor://localhost, https://localhost,
# http://localhost:3000, http://127.0.0.1:3000, و NEXT_PUBLIC_APP_URL.
# يجب تطابق البروتوكول + المضيف + المنفذ حرفياً.
PENRX_ALLOWED_ORIGINS=https://<your-app-host>,https://<your-custom-domain>

# إرثي (للسطح فقط): electron/start-server.js يضبطه لقشرة التطبيق، ولا تقرأه أي
# شريحة سيرفر بعد الآن — البوابة أصبحت على /admin/portal.
# NEXT_PUBLIC_ADMIN_PORTAL_URL=https://<your-app-host>/admin/portal

# ----------------------------------------------------------------------------
# 4) بوابة الإدارة  — src/lib/adminAuth.ts
#    صفحة البوابة لا تحتوي على أي بيانات دخول: المستخدم يكتب البريد وكلمة
#    المرور والـ PIN، والسيرفر يشتق الهاشات ويقارنها بالقيم هنا.
#    لو أحد الثلاثة فارغ → البوابة مغلقة تماماً ورسالتها:
#    «بوابة الإدارة غير مُهيّأة…»
# ----------------------------------------------------------------------------
# البريد (مقارنة بدون حساسية لحالة الأحرف وبتوقيت ثابت).
PENRX_ADMIN_EMAIL=<admin@your-domain>

# ملح هاش كلمة المرور.  اضبط قيمة عشوائية بنفسك: الاحتياطي المدمج
# LEGACY_PASSWORD_SALT ثابت ومتواجد في الكود العام، فالاعتماد عليه بلا ملح.
# ⚠️ تغيير الملح يستلزم إعادة حساب PASSWORD_HASH و PIN_HASH في نفس الخطوة.
PENRX_ADMIN_SALT=<paste-32-plus-random-chars>

#   PASSWORD_HASH = PBKDF2(password, PENRX_ADMIN_SALT, 10000, 64 bytes, sha512) → hex (128)
#   PIN_HASH      = SHA-256(pin.trim())                                          → hex (64)
#   ⚠️ هاش الـ PIN بدون ملح: اختر طويلاً عشوائياً (12+ حرفاً) لا كوداً من 4 أرقام.
#
# التوليد الآمن (القيم لا تظهر ولا تدخل في سجل الأوامر):
#   read -rs PW   && export PW      # اكتب كلمة المرور ثم Enter (لا تظهر على الشاشة)
#   read -rs PIN  && export PIN     # اكتب رمز الأمان (8 أحرف/أرقام على الأقل)
#   read -rs SALT && export SALT    # نفس الملح المكتوب في PENRX_ADMIN_SALT أعلاه
#   node scripts/gen-admin-credentials.js
# السكربت يقرأ من البيئة فقط، لا يطبع أي سر، ويُخرج ثلاثة أسطر جاهزة للصق في Vercel.
PENRX_ADMIN_PASSWORD_HASH=<128-hex-chars>
PENRX_ADMIN_PIN_HASH=<64-hex-chars>

# ----------------------------------------------------------------------------
# 5) مزايا اختيارية
# ----------------------------------------------------------------------------
# مفتاح Google Gemini للتحليل الذكي للأدوية والتفاعلات.  بدونه ترجع نقاط الذكاء
# الاصطناعي رسالة «الذكاء الاصطناعي غير مُفعّل» بشكل آمن.
GEMINI_API_KEY=<paste-gemini-key-or-leave-empty>

# الكتابة المزدوجة على الجداول العلائقية بجانب مخزّن مستندات JSON.  لا تعمل إلا
# بالقيمة "true".  الافتراضي: متوقف.
ENABLE_RELATIONAL_DUAL_WRITE=false

# يمنع اتصال Next.js بالتحليلات أثناء البناء.
NEXT_TELEMETRY_DISABLED=1

# ----------------------------------------------------------------------------
# 6) بناء APK (Capacitor) — لا يقرأه السيرفر
# ----------------------------------------------------------------------------
# التطبيق الأصلي يفتح النشر السحابي الحيّ، و capacitor.config.ts يفرض HTTPS.
# المفضّل استخدام mobile-config.json بدلاً من هذا المتغير.
# CAPACITOR_SERVER_URL=https://<your-app-host>

# ----------------------------------------------------------------------------
# 7) قيم يضبطها التشغيل تلقائياً — لا تُعرِّفها بنفسك
# ----------------------------------------------------------------------------
#   NODE_ENV                     next dev / build / start
#   VERCEL, NEXT_PUBLIC_VERCEL_ENV   موجودة على Vercel وتعلِم المضيف أنه خاص
#   PENRX_DESKTOP_RUNTIME=1      تضبطه قشرة Electron: يفرض تمرير API للسحابة
#   ELECTRON_RUN_AS_NODE=1       عند تشغيل خادم Next المدمج (لا يُوثق به)
#   PORT                         تختاره electron/start-server.js (افتراضي 3000)

# ----------------------------------------------------------------------------
# 8) GitHub Actions  (Settings → Secrets and variables → Actions)
#    المطلوب للبناء فقط — انظر .github/workflows/build-and-release.yml
# ----------------------------------------------------------------------------
#   vars:    NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_APP_URL,
#            PENRX_CLOUD_API_URL
#   secrets: GEMINI_API_KEY (اختياري), KEYSTORE_* و WIN_CSC_* للتوقيع
#   لا تُضبط أي مفاتيح Supabase خاصة في CI إطلاقاً.

# ----------------------------------------------------------------------------
# 9) التحقق بعد الضبط  (من جهازك، وليس من المتصفح)
# ----------------------------------------------------------------------------
# ⚠️ هذا الملف لا يعمل وحده على Vercel: Next.js يقرأ .env و .env.local و
#    .env.production فقط، وملفات .env لا تُرفع مع النشر لأنها في .gitignore.
#    فالطريقان الوحيدان: الإدخال اليدوي في لوحة Vercel، أو الدفع بالـAPI من ملف
#    .env محلي (لا يُرفع للجيت):
#
#      cp .env.example .env        # ثم اكتب القيم الحقيقية في .env فقط
#      read -rs VERCEL_TOKEN && export VERCEL_TOKEN   # من Vercel → Account → Tokens
#      node scripts/push-vercel-env.js --project=pen-rx --file=.env            # معاينة
#      node scripts/push-vercel-env.js --project=pen-rx --file=.env --apply    # تنفيذ
#      node scripts/push-vercel-env.js --project=pen-rx --list                 # أسماء فقط
#
#    السكربت يرفض placeholder، ويمنع مفتاح HS256 المسرّب، ويتحقق من أطوال الهاشات،
#    ولا يطبع أي قيمة.  ثم اضغط Redeploy (أو ادفع commitاً جديداً) لتسري القيم.
#   curl -s "https://pen-rx.vercel.app/api/system/verify?machineId=TEST123456789012"
#       → JSON (ولو {"status":"none"}) وليس 502 ولا HTML
#
#   curl -s -o /dev/null -w "%{http_code}\n" \
#     "https://<ref>.supabase.co/rest/v1/Subscription?select=id&limit=1" \
#     -H "apikey: <المفتاح-القديم-HS256>" -H "Authorization: Bearer <المفتاح-القديم>"
#       → 401  (إلغاء المفتاح المسرّب تم)
#
#   git grep -I -n -e "eyJhbGciOiJIUzI1NiI" -e "qspaigplwyvpqbmszpgc" -- ':!.env.example'
#       → لا نتائج  (لا أسرار في الملفات المتتبَّعة بـ Git)
#   راقب أيضاً مخرجات البناء القديمة غير المتتبَّعة، فقد تحمل المفتاح المسرّب:
#       out/index.html  و  android/app/src/main/assets/public/index.html
#       (يُعاد توليدهما من npx next build ثم npx cap sync بعد الإصلاح)
